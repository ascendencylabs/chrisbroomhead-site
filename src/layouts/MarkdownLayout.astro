---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/site/PageHero.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <PageHero idx="L" label="Legal" lines={[frontmatter.title ?? '']} />
  <section class="section !pt-4">
    <div class="wrap">
      <div
        class="prose prose-lg prose-invert max-w-3xl prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-[var(--cb-ink)] prose-p:text-[var(--cb-ink-2)] prose-li:text-[var(--cb-ink-2)] prose-a:text-[var(--cb-amber)] prose-strong:text-[var(--cb-ink)] prose-th:text-[var(--cb-ink)] prose-td:text-[var(--cb-ink-2)] prose-table:text-sm"
      >
        <slot />
      </div>
    </div>
  </section>
</Layout>
