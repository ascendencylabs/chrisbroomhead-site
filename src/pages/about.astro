---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import photo from '~/assets/images/chris-about.jpg';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About Chris Broomhead',
  description:
    'Chris Broomhead: from personal trainer and online coach to protocol design consultations. Manchester-born, UK-based.',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-6xl mx-auto">
    <div class="grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <Image
        src={photo}
        alt="Chris Broomhead smiling, holding a phone, in a white T-shirt"
        class="aspect-[4/5] w-full rounded-2xl object-cover object-top shadow-xl"
        widths={[400, 640, 800]}
        sizes="(max-width: 1023px) 90vw, 440px"
        width={800}
        height={1000}
        format="webp"
      />
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent dark:text-primary">About</p>
        <h1 class="mt-3 font-heading text-4xl font-bold leading-tighter tracking-tighter text-heading md:text-5xl">
          Evidence first. Everything written down.
        </h1>
        <div class="mt-6 space-y-5 text-lg leading-8">
          <p>I'm Chris Broomhead. Made in Manchester, based in the UK.</p>
          <p>
            I started as a personal trainer and online coach. Training plans, nutrition, accountability. Over time the
            questions clients brought me changed. Less about sets and reps. More about bloodwork, hormones, recovery and
            peptides.
          </p>
          <p>
            Those questions deserve more than a forum thread. They deserve a protocol built on data: your markers, your
            history, your goal. That is what my consultations are.
          </p>
          <p>
            No hype. No cookie-cutter stacks. A structured review before the call, a straight answer on it, and a written
            summary after it.
          </p>
        </div>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a class="btn-primary" href={getPermalink('/book')}>Book a consultation</a>
          <a class="btn-secondary" href={getPermalink('/work-with-me')}>See sessions and prices</a>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <CallToAction
    title="Not sure where to start?"
    subtitle="Book the free 15-minute suitability call. You will leave knowing which session fits."
    actions={[{ variant: 'primary', text: 'Book the free call', href: getPermalink('/book#suitability') }]}
  />
</Layout>
