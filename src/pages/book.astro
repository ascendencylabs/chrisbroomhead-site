---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import CalendlyBooking from '~/components/site/CalendlyBooking.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Book a consultation',
  description: 'Choose a consultation with Chris Broomhead, pick a time and pay securely online.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://assets.calendly.com" />
    <link rel="preconnect" href="https://calendly.com" />
  </Fragment>
  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <Headline
      tagline="Book"
      title="Book a consultation"
      subtitle="Choose a session, then pick a time. The 30-minute private consultation is selected by default."
    />
    <CalendlyBooking />
    <p class="mt-8 text-sm text-muted">
      Questions before booking? <a class="underline" href={getPermalink('/contact')}>Get in touch</a>. Read the
      <a class="underline" href={getPermalink('/terms')}>terms</a> before you pay.
    </p>
  </WidgetWrapper>
</Layout>
