---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import CalendlyBooking from '~/components/site/CalendlyBooking.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Book a consultation',
  description: 'Choose a consultation with Chris Broomhead, pick a time and pay securely online.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://assets.calendly.com" />
    <link rel="preconnect" href="https://calendly.com" />
  </Fragment>
  <PageHero
    idx="B"
    label="Book"
    lines={['Choose a session.', '<em>Pick a time.</em>']}
    lead="The 30-minute private consultation is selected by default. Paid sessions are paid by card at booking; the Zoom link arrives in your confirmation email."
  />
  <section class="section !pt-6" aria-label="Booking calendar">
    <div class="wrap">
      <CalendlyBooking />
      <p class="mt-10 text-sm">
        Questions before booking? <a class="link-u" href={getPermalink('/contact')}>Get in touch</a>. Read the{' '}
        <a class="link-u" href={getPermalink('/terms')}>terms</a> before you pay.
      </p>
    </div>
  </section>
</Layout>
