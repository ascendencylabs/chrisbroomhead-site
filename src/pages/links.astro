---
import Layout from '~/layouts/PageLayout.astro';
import { SOCIALS, CALENDLY_PROFILE, CONTACT, OFFERS } from '~/data/site';
import { STREAMS } from '~/config/streams';
import { getPermalink } from '~/utils/permalinks';
import Image from '~/components/common/Image.astro';
import portrait from '~/assets/images/chris-navy.jpg';

const metadata = {
  title: 'Links',
  description:
    'Every Chris Broomhead link in one place — consultations, free guide, newsletter, social channels and contact.',
};

const live = (id: string) => STREAMS.find((s) => s.id === id && s.launched);

interface LinkItem {
  text: string;
  meta: string;
  href: string;
  primary?: boolean;
  external?: boolean;
}

const links: LinkItem[] = [
  { text: 'Book a consultation', meta: 'from free', href: getPermalink('/book'), primary: true },
  ...OFFERS.slice(0, 2).map((o) => ({
    text: o.shortName,
    meta: `${o.duration} · ${o.priceLabel}`,
    href: o.url,
    external: true,
  })),
  { text: 'Free Bloodwork Brief', meta: 'PDF download', href: getPermalink('/free-guide') },
  ...(live('newsletter')
    ? [{ text: "The Operator's Lab", meta: 'Free newsletter', href: getPermalink('/newsletter') }]
    : []),
  ...(live('community') ? [{ text: 'Community', meta: 'Join', href: getPermalink('/community') }] : []),
  ...SOCIALS.map((s) => ({ text: s.label, meta: s.handle, href: s.href, external: true })),
  { text: 'Email', meta: CONTACT.email, href: `mailto:${CONTACT.email}` },
];
---

<Layout metadata={metadata}>
  <section class="relative pt-32 pb-24">
    <div
      class="absolute inset-0 bg-[radial-gradient(50%_40%_at_50%_0%,rgb(214_165_78/0.12),transparent_70%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-md px-4">
      <div class="flex flex-col items-center text-center">
        <div
          class="h-24 w-24 overflow-hidden rounded-full shadow-[0_0_0_1px_var(--cb-line-strong),0_0_0_6px_var(--cb-ground),0_0_0_7px_var(--cb-line)]"
        >
          <Image
            src={portrait}
            alt="Chris Broomhead"
            widths={[96, 192]}
            sizes="96px"
            layout="none"
            loading="eager"
            format="webp"
            style="object-position:50% 18%;width:100%;height:100%;object-fit:cover"
          />
        </div>
        <h1 class="display mt-6 text-4xl">Chris Broomhead</h1>
        <p class="meta mt-3">Protocol design consultations · {CONTACT.location}</p>
      </div>
      <ul class="mt-10 grid gap-3">
        {
          links.map((l, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a
                href={l.href}
                {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                class:list={[
                  'spot relative flex items-center justify-between gap-4 rounded-2xl px-5 py-4 no-underline transition',
                  l.primary
                    ? 'bg-[var(--cb-amber)] font-semibold text-[var(--cb-ground)] hover:bg-[var(--cb-amber-hi)]'
                    : 'text-[var(--cb-ink)] shadow-[inset_0_0_0_1px_var(--cb-line-strong)] hover:bg-[rgb(236_232_225/0.04)]',
                ]}
              >
                <span class="font-medium">{l.text}</span>
                <span
                  class:list={[
                    'mono text-[0.75rem]',
                    l.primary ? 'text-[var(--cb-ground)]/70' : 'text-[var(--cb-ink-3)]',
                  ]}
                >
                  {l.meta}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="meta mt-10 text-center">
        Bookings via <a href={CALENDLY_PROFILE} target="_blank" rel="noopener" class="link-u">Calendly</a>
      </p>
    </div>
  </section>
</Layout>
