---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import LeadForm from '~/components/site/LeadForm.astro';
import { LEAD_MAGNET } from '~/data/site';
import { productBySlug } from '~/config/products';
import { streamById } from '~/config/streams';
import { getAsset, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Free guide: The Consultation Bloodwork Brief',
  description:
    'The bloodwork markers to ask for, how to prepare for the test, and what to gather before any protocol conversation. Free PDF.',
};

const brief = productBySlug('consultation-bloodwork-brief')!;
---

<Layout metadata={metadata}>
  <PageHero
    idx="F"
    label="Free PDF"
    lines={['The Consultation', '<em>Bloodwork Brief.</em>']}
    lead="A protocol written without bloodwork is a guess. This brief tells you what to ask for, how to prepare for the draw, and what to have ready before a consultation."
  />

  <section class="section !pt-6" aria-labelledby="get-brief">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <SectionHead idx="F.1" label="Inside">
          <span id="get-brief">{brief.pages} pages. <span class="thin">No filler.</span></span>
        </SectionHead>
        <ol class="mt-12 border-t border-[var(--cb-line-strong)]">
          {
            brief.contents.map((c, i) => (
              <li
                class="grid grid-cols-[3rem_1fr] gap-4 border-b border-[var(--cb-line)] py-6"
                data-reveal
                style={`--d:${i}`}
              >
                <span class="meta pt-1 text-[var(--cb-amber)]">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="block text-lg font-medium tracking-tight text-[var(--cb-ink)]">{c.title}</span>
                  <span class="mt-1 block">{c.detail}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="meta mt-6">Educational information only. Not medical advice.</p>
      </div>
      <div class="panel spot lg:sticky lg:top-28" data-reveal>
        <p class="eyebrow"><span class="idx">PDF</span> Send me the brief</p>
        <p class="mt-4">The download opens straight after you submit.</p>
        <div class="mt-8">
          <LeadForm
            guide={LEAD_MAGNET.guideId}
            source={streamById('free-guides').leadSource}
            tags={['lead-magnet', 'bloodwork-brief', 'website']}
            buttonText="Get the free brief"
            successTitle="Done. Your brief is ready."
            successBody="Download it below. When your bloodwork is back, book a session and send it over 48 to 72 hours before the call."
            downloadHref={getAsset(LEAD_MAGNET.file)}
            downloadText="Download the PDF"
          />
        </div>
        <p class="mt-8 text-sm">
          Already have your bloodwork? <a class="link-u" href={getPermalink('/book')}>Book a consultation</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
