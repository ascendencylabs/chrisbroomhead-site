---
import Layout from '~/layouts/PageLayout.astro';
import CtaButton from '~/components/site/CtaButton.astro';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';
---

<Layout metadata={{ title: 'Page not found', robots: { index: false, follow: false } }}>
  <section class="hero !justify-center">
    <div class="wrap relative">
      <p class="eyebrow"><span class="idx">§ 404</span> No result</p>
      <h1 class="display display-xl mt-6">
        <span class="line-mask"><span style="--i:0">This page</span></span>
        <span class="line-mask"><span class="thin" style="--i:1">isn’t in the record.</span></span>
      </h1>
      <p class="lead mt-8" data-fade>The link may be old, or mistyped. Everything else is one step away.</p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row" data-fade>
        <CtaButton href={getHomePermalink()}>Back to the homepage</CtaButton>
        <CtaButton href={getPermalink('/book')} variant="ghost">Book a consultation</CtaButton>
      </div>
    </div>
  </section>
</Layout>
