---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import WaitlistPanel from '~/components/site/WaitlistPanel.astro';
import CtaButton from '~/components/site/CtaButton.astro';
import { communityUrl } from '~/config/streams';

const metadata = {
  title: 'Community',
  description: 'A private community for people running their own protocols. Join the waitlist.',
};

const promise = [
  {
    k: 'Protocol breakdowns',
    v: 'How a protocol is reasoned through, start to finish: objective, baseline, sequence, review.',
  },
  {
    k: 'Bloodwork discussion',
    v: 'Reading markers in context, what to retest and when, and how to prepare for a draw.',
  },
  { k: 'Direct access', v: 'Questions answered by Chris in the group, not by a team.' },
  { k: 'A serious room', v: 'People who keep records and measure what they change. No hype, no selling.' },
];

const rules = [
  'Education only. No medical advice, no diagnosis, no prescriptions.',
  'No buying, selling or sourcing of any product or medicine, in posts or in messages.',
  'Bring data. Opinions are welcome; evidence is better.',
  'Respect privacy. What members share stays in the group.',
];
---

<Layout metadata={metadata}>
  <PageHero
    idx="CO"
    label="Community"
    status="Not open yet"
    lines={['A room for people', 'who run <em>a protocol.</em>']}
    lead="A private community for people running their own protocols: protocol breakdowns, bloodwork discussion, and direct access to Chris. It is being built now."
  >
    {
      communityUrl ? (
        <CtaButton href={communityUrl} external>
          Join the community
        </CtaButton>
      ) : (
        <CtaButton href="#join" arrow="down">
          Join the waitlist
        </CtaButton>
      )
    }
  </PageHero>

  <section class="section !pt-6" aria-labelledby="co-promise">
    <div class="wrap grid items-start gap-14 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div>
        <SectionHead idx="CO.1" label="Inside">
          <span id="co-promise">What it is <em>for.</em></span>
        </SectionHead>
        <div class="mt-12 border-t border-[var(--cb-line-strong)]">
          {
            promise.map((p, i) => (
              <div
                class="grid gap-2 border-b border-[var(--cb-line)] py-7 sm:grid-cols-[13rem_1fr] sm:gap-8"
                data-reveal
                style={`--d:${i}`}
              >
                <p class="text-lg font-medium tracking-tight text-[var(--cb-ink)]">{p.k}</p>
                <p>{p.v}</p>
              </div>
            ))
          }
        </div>
        <h3 class="h3 mt-16">House rules</h3>
        <ul class="ticks mt-6">{rules.map((r) => <li>{r}</li>)}</ul>
      </div>
      <div class="lg:sticky lg:top-28">
        <WaitlistPanel
          stream="community"
          guide="community-waitlist"
          title="Join the waitlist"
          note="One email when the doors open. Waitlist members get in first."
          buttonText="Join the waitlist"
        />
      </div>
    </div>
  </section>
</Layout>
