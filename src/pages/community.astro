---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import LeadForm from '~/components/site/LeadForm.astro';
import { Icon } from 'astro-icon/components';
import { SOCIALS } from '~/data/site';

const metadata = {
  title: 'Community',
  description: 'Join the waitlist for the Chris Broomhead community, and follow along on social.',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-6xl mx-auto">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent dark:text-primary">Community</p>
        <h1 class="mt-3 font-heading text-4xl font-bold leading-tighter tracking-tighter text-heading md:text-5xl">
          The community is being built. Get in first.
        </h1>
        <p class="mt-6 text-lg leading-8">
          A private community for people running their own protocols: protocol breakdowns, bloodwork discussion and direct
          access to Chris. It is not open yet.
        </p>
        <p class="mt-4 leading-7">Join the waitlist and you will be told first when the doors open.</p>
        <div class="mt-10">
          <p class="font-semibold text-heading">Follow along now</p>
          <ul class="mt-4 space-y-3">
            {
              SOCIALS.map((s) => (
                <li>
                  <a
                    class="inline-flex items-center gap-3 rounded-lg border border-gray-200 px-4 py-3 hover:border-primary dark:border-slate-700"
                    href={s.href}
                    rel="me noopener"
                    target="_blank"
                  >
                    <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                    <span>
                      {s.label} <span class="text-muted">{s.handle}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900/60 md:p-8">
        <p class="text-xl font-bold text-heading">Join the waitlist</p>
        <p class="mt-1 mb-6 text-sm text-muted">One email when it opens.</p>
        <LeadForm
          guide="community-waitlist"
          tags={['community-waitlist', 'skool', 'website']}
          buttonText="Join the waitlist"
          successTitle="You are on the list."
          successBody="You will hear first when the community opens."
        />
      </div>
    </div>
  </WidgetWrapper>
</Layout>
