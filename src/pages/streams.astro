---
// Internal: every income stream, its status and what it needs to go live.
// Not linked anywhere, noindex, excluded from the sitemap (INTERNAL_PATHS).
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import { STREAMS } from '~/config/streams';
import { PRODUCTS, isPurchasable } from '~/config/products';
import { getPermalink } from '~/utils/permalinks';

const metadata = { title: 'Income streams — internal', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <PageHero
    idx="INT"
    label="Internal"
    lines={['Income streams.']}
    lead="Switch a stream on by setting launched: true in src/config/streams.ts. That adds it to the navigation and the sitemap, and removes noindex."
  />
  <section class="section !pt-4">
    <div class="wrap">
      <div class="ledger">
        {
          STREAMS.map((s, i) => (
            <div class="grid gap-3 border-b border-[var(--cb-line)] py-6 lg:grid-cols-[3rem_14rem_8rem_1fr] lg:gap-8">
              <span class="meta pt-1">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <a class="link-u text-lg" href={getPermalink(s.path)}>
                  {s.label}
                </a>
                <span class="meta mt-1 block">{s.path}</span>
              </span>
              <span>
                {s.launched ? <span class="tag tag--assay">Live</span> : <span class="tag tag--muted">Hidden</span>}
              </span>
              <span>
                <span class="block">{s.summary}</span>
                <span class="meta mt-2 block">leads.source = chrisbroomhead-site:{s.leadSource}</span>
                {s.needsToLaunch.length > 0 && (
                  <ul class="ticks mt-3 text-[0.92rem]">
                    {s.needsToLaunch.map((n) => (
                      <li>{n}</li>
                    ))}
                  </ul>
                )}
              </span>
            </div>
          ))
        }
      </div>
      <h2 class="h3 mt-16">Guides (src/config/products.ts)</h2>
      <div class="ledger mt-6">
        {
          PRODUCTS.map((p) => (
            <div class="grid gap-2 border-b border-[var(--cb-line)] py-5 lg:grid-cols-[16rem_8rem_1fr] lg:gap-8">
              <span class="text-[var(--cb-ink)]">{p.title}</span>
              <span class="meta">{p.free ? 'Free' : isPurchasable(p) ? `£${p.price}` : 'No price / link'}</span>
              <span class="text-[0.9rem]">{p.reviewNote}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
