---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { CONTACT, SOCIALS } from '~/data/site';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Contact',
  description: 'Contact Christopher Broomhead by email or phone, or book a consultation online.',
};

const cards = [
  { label: 'Email', value: CONTACT.email, href: `mailto:${CONTACT.email}`, icon: 'tabler:mail' },
  { label: 'Phone', value: CONTACT.phoneDisplay, href: CONTACT.phoneHref, icon: 'tabler:phone' },
  {
    label: 'Book online',
    value: 'Free 15-minute call or paid sessions from £50',
    href: getPermalink('/book'),
    icon: 'tabler:calendar',
  },
  ...SOCIALS.map((s) => ({ label: s.label, value: s.handle, href: s.href, icon: s.icon, external: true })),
];
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-4xl mx-auto">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent dark:text-primary">Contact</p>
    <h1 class="mt-3 font-heading text-4xl font-bold leading-tighter tracking-tighter text-heading md:text-5xl">
      Get in touch
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-8">
      The fastest way to work together is to <a class="underline" href={getPermalink('/book')}>book a session</a>. For
      anything else, email or call.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        cards.map((c) => (
          <a
            href={c.href}
            {...('external' in c ? { target: '_blank', rel: 'me noopener' } : {})}
            class="flex items-start gap-4 rounded-2xl border border-gray-200 p-6 hover:border-primary dark:border-slate-700"
          >
            <Icon name={c.icon} class="h-7 w-7 flex-none text-primary" aria-hidden="true" />
            <span>
              <span class="block font-semibold text-heading">{c.label}</span>
              <span class="mt-1 block break-all">{c.value}</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-muted">
      {CONTACT.name}, trading as {CONTACT.tradingAs}. {CONTACT.location}. Not for medical emergencies: call 999 or NHS 111.
    </p>
  </WidgetWrapper>
</Layout>
