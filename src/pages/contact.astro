---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import { Icon } from 'astro-icon/components';
import { CONTACT, SOCIALS } from '~/data/site';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Contact',
  description: 'Contact Christopher Broomhead by email or phone, or book a consultation online.',
};

const cards = [
  { label: 'Email', value: CONTACT.email, href: `mailto:${CONTACT.email}`, icon: 'tabler:mail' },
  { label: 'Phone', value: CONTACT.phoneDisplay, href: CONTACT.phoneHref, icon: 'tabler:phone' },
  {
    label: 'Book online',
    value: 'Free 15-minute call or paid sessions from £50',
    href: getPermalink('/book'),
    icon: 'tabler:calendar',
  },
  ...SOCIALS.map((s) => ({ label: s.label, value: s.handle, href: s.href, icon: s.icon, external: true })),
];
---

<Layout metadata={metadata}>
  <PageHero
    idx="C"
    label="Contact"
    lines={['Get in touch.']}
    lead="The fastest way to work together is to book a session. For anything else, email or call."
  />
  <section class="section !pt-6" aria-label="Contact details">
    <div class="wrap">
      <div class="grid gap-px overflow-hidden rounded-[1.5rem] bg-[var(--cb-line)] sm:grid-cols-2">
        {
          cards.map((c, i) => (
            <a
              href={c.href}
              {...('external' in c ? { target: '_blank', rel: 'me noopener' } : {})}
              class="spot group relative flex items-start gap-5 bg-[var(--cb-ground)] p-7 no-underline transition hover:bg-[var(--cb-ground-2)] md:p-10"
              data-reveal
              style={`--d:${i}`}
            >
              <Icon name={c.icon} class="h-6 w-6 flex-none text-[var(--cb-amber)]" aria-hidden="true" />
              <span>
                <span class="meta block uppercase tracking-[0.14em]">{c.label}</span>
                <span class="mt-2 block text-xl tracking-tight text-[var(--cb-ink)] [overflow-wrap:anywhere] md:text-2xl">
                  {c.value}
                </span>
              </span>
            </a>
          ))
        }
      </div>
      <p class="meta mt-10 leading-6">
        {CONTACT.name}, trading as {CONTACT.tradingAs}. {CONTACT.location}. Not for medical emergencies: call 999 or NHS
        111.
      </p>
    </div>
  </section>
</Layout>
