---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import OfferCards from '~/components/site/OfferCards.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Work with me — consultations and prices',
  description:
    'Protocol design consultations with Chris Broomhead: free 15-minute suitability call, £50 15-minute session, £100 30-minute review, £150 60-minute comprehensive consultation.',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <Headline
      tagline="Work with me"
      title="Consultations and prices"
      subtitle="Every session runs on Zoom. Paid sessions are paid by card at booking. Each one includes a review of what you send before the call and a written summary after it."
    />
    <OfferCards detailed includeExistingClients />
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-4xl mx-auto">
    <Headline tagline="Scope" title="What a consultation covers" />
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <p class="font-semibold text-heading">In scope</p>
        <ul class="mt-3 space-y-2 leading-7">
          <li>— Peptide protocol design and refinement</li>
          <li>— Dosing architecture, sequencing and cycling</li>
          <li>— Bloodwork interpretation in the context of your protocol</li>
          <li>— Hormonal, metabolic, recovery and cognitive strategy</li>
          <li>— Side-effect review and phased programme design</li>
        </ul>
      </div>
      <div>
        <p class="font-semibold text-heading">Out of scope</p>
        <ul class="mt-3 space-y-2 leading-7">
          <li>— Diagnosis or treatment of any medical condition</li>
          <li>— Prescriptions</li>
          <li>— Emergency advice. If you feel unwell, contact your GP, NHS 111 or emergency services.</li>
        </ul>
        <p class="mt-4 text-sm text-muted">
          Consultations are educational and evidence-informed. They are not medical advice. Discuss any changes with
          your healthcare provider.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <FAQs
    title="Booking, payment and changes"
    items={[
      {
        title: 'How is payment taken?',
        description:
          'At booking, by card, through Stripe inside the Calendly page. You receive a receipt and a calendar invitation with the Zoom link.',
      },
      {
        title: 'What happens if I do not send bloodwork in time?',
        description:
          'The session still runs, but the review is limited to what was sent. Send it 48 hours ahead for 30 minutes and 72 hours ahead for 60 minutes.',
      },
      {
        title: 'How do I reschedule or cancel?',
        description:
          'Use the link in your confirmation email, or email admin@chrisbroomheadcoaching.com. See the terms for refunds.',
      },
    ]}
  />

  <CallToAction
    title="Ready when you are"
    subtitle="Pick a session and a time. It takes about two minutes."
    actions={[{ variant: 'primary', text: 'Book a consultation', href: getPermalink('/book') }]}
  />
</Layout>
