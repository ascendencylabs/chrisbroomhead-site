---
import { Icon } from 'astro-icon/components';
import { OFFERS, type Offer } from '~/data/site';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  /** Show the full "includes" list and prep notes (work-with-me page). */
  detailed?: boolean;
  includeExistingClients?: boolean;
}

const { detailed = false, includeExistingClients = false } = Astro.props;
const offers: Offer[] = OFFERS.filter((o) => includeExistingClients || !o.existingClientsOnly);
---

<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
  {
    offers.map((offer) => (
      <article
        id={offer.slug}
        class:list={[
          'relative flex flex-col rounded-2xl border bg-white p-6 shadow-sm dark:bg-slate-900/60',
          offer.highlight ? 'border-primary ring-1 ring-primary' : 'border-gray-200 dark:border-slate-700',
        ]}
      >
        {offer.highlight && (
          <p class="absolute -top-3 left-6 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-white dark:text-slate-950">
            Most booked
          </p>
        )}
        <h3 class="text-lg font-bold leading-snug text-heading">{offer.shortName}</h3>
        <p class="mt-1 text-sm text-muted">{offer.duration} · Zoom</p>
        <p class="mt-4 text-4xl font-extrabold text-heading">
          {offer.priceLabel}
          {offer.price > 0 && <span class="ml-1 text-base font-medium text-muted">GBP</span>}
        </p>
        <p class="mt-4 text-sm leading-6">{offer.summary}</p>
        {detailed && (
          <>
            <ul class="mt-4 space-y-2 text-sm">
              {offer.includes.map((item) => (
                <li class="flex gap-2">
                  <Icon name="tabler:check" class="mt-0.5 h-4 w-4 flex-none text-primary" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-xs leading-5 text-muted">
              <strong class="font-semibold">Best if:</strong> {offer.forWhom}
              <br />
              <strong class="font-semibold">Before the call:</strong> {offer.prep}
            </p>
          </>
        )}
        <div class="mt-auto pt-6">
          <a
            href={getPermalink(`/book#${offer.slug}`)}
            class:list={['w-full', offer.highlight ? 'btn-primary' : 'btn-secondary']}
            aria-label={`Book: ${offer.name} (${offer.priceLabel})`}
          >
            {offer.price === 0 ? 'Book free call' : `Book · ${offer.priceLabel}`}
          </a>
        </div>
      </article>
    ))
  }
</div>
