---
import { OFFERS } from '~/data/site';

// Colour params are honoured on paid Calendly plans and ignored otherwise.
const query = 'hide_gdpr_banner=1&background_color=121412&text_color=ece8e1&primary_color=d6a54e';
---

<cb-booking data-query={query}>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_1fr]">
    <nav aria-label="Choose a consultation" class="lg:sticky lg:top-28 lg:self-start">
      <ul class="grid gap-3">
        {
          OFFERS.map((offer, i) => (
            <li id={offer.slug === 'initial-consultation-suitability-assessment' ? 'suitability' : undefined}>
              <a
                href={offer.url}
                data-offer={offer.slug}
                aria-current={i === 2 ? 'true' : undefined}
                class="relative block rounded-2xl p-5 no-underline shadow-[inset_0_0_0_1px_var(--cb-line)] transition hover:shadow-[inset_0_0_0_1px_var(--cb-line-strong)] aria-[current=true]:bg-[rgb(214_165_78/0.06)] aria-[current=true]:shadow-[inset_0_0_0_1px_var(--cb-amber)]"
              >
                <span class="flex items-baseline justify-between gap-3">
                  <span class="font-semibold tracking-tight text-[var(--cb-ink)]">{offer.shortName}</span>
                  <span class="text-xl font-light tracking-tight text-[var(--cb-ink)]">{offer.priceLabel}</span>
                </span>
                <span class="meta mt-1.5 block">
                  {offer.duration}
                  {offer.existingClientsOnly ? ' · existing clients only' : ''}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="meta mt-5 leading-5">
        Paid sessions are paid by card at booking (secure checkout by Stripe inside Calendly). Zoom details arrive in
        your confirmation email.
      </p>
    </nav>
    <div>
      <div
        data-embed
        class="h-[1000px] min-w-[300px] overflow-hidden rounded-[1.25rem] bg-[var(--cb-ground-2)] shadow-[inset_0_0_0_1px_var(--cb-line)] md:h-[760px]"
        aria-live="polite"
      >
        <noscript>
          <p class="p-6">Choose a session on the left to open the booking page.</p>
        </noscript>
      </div>
    </div>
  </div>
</cb-booking>

<script>
  declare global {
    interface Window {
      Calendly?: { initInlineWidget: (opts: { url: string; parentElement: HTMLElement }) => void };
    }
  }

  const SCRIPT = 'https://assets.calendly.com/assets/external/widget.js';

  const loadCalendly = (): Promise<void> =>
    new Promise((resolve, reject) => {
      if (window.Calendly) return resolve();
      const existing = document.querySelector<HTMLScriptElement>(`script[src="${SCRIPT}"]`);
      const script = existing ?? document.createElement('script');
      script.addEventListener('load', () => resolve());
      script.addEventListener('error', () => reject(new Error('Calendly failed to load')));
      if (!existing) {
        script.src = SCRIPT;
        script.async = true;
        document.head.appendChild(script);
      }
    });

  class CbBooking extends HTMLElement {
    connectedCallback() {
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[data-offer]'));
      const embed = this.querySelector<HTMLElement>('[data-embed]')!;
      const query = this.dataset.query || '';

      const show = async (link: HTMLAnchorElement) => {
        links.forEach((l) => l.removeAttribute('aria-current'));
        link.setAttribute('aria-current', 'true');
        try {
          await loadCalendly();
          embed.innerHTML = '';
          window.Calendly!.initInlineWidget({ url: `${link.href}?${query}`, parentElement: embed });
        } catch {
          embed.innerHTML = '';
          const p = document.createElement('p');
          p.className = 'p-6';
          const a = document.createElement('a');
          a.href = link.href;
          a.className = 'underline';
          a.textContent = 'Open the booking page';
          p.append('The booking calendar could not load here. ', a, '.');
          embed.append(p);
        }
      };

      links.forEach((link) =>
        link.addEventListener('click', (e) => {
          e.preventDefault();
          history.replaceState(null, '', `#${link.dataset.offer}`);
          show(link);
        })
      );

      const hash = location.hash.replace('#', '');
      const initial =
        links.find((l) => l.dataset.offer === hash) ||
        (hash === 'suitability' ? links[0] : undefined) ||
        links.find((l) => l.getAttribute('aria-current') === 'true') ||
        links[0];
      show(initial);
    }
  }

  if (!customElements.get('cb-booking')) customElements.define('cb-booking', CbBooking);
</script>
