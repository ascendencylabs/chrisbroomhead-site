---
import { LEADS_ENDPOINT } from '~/data/site';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  /** Stored in leads.guide (the specific asset or list). */
  guide: string;
  /** Stream tag from src/config/streams.ts, stored in leads.source. */
  source: string;
  tags: string[];
  buttonText: string;
  successTitle: string;
  successBody: string;
  /** Optional download revealed after a successful submit. */
  downloadHref?: string;
  downloadText?: string;
  /** Optional extra fields. */
  role?: { label: string; options: string[] };
  message?: { label: string; placeholder?: string; required?: boolean };
  phone?: boolean;
  consent?: string;
}

const {
  guide,
  source,
  tags,
  buttonText,
  successTitle,
  successBody,
  downloadHref,
  downloadText,
  role,
  message,
  phone = false,
  consent = 'By submitting you agree to receive this and occasional related emails from Christopher Broomhead.',
} = Astro.props;

const formId = `lead-${guide}`;
---

<cb-lead-form
  data-endpoint={LEADS_ENDPOINT.url}
  data-key={LEADS_ENDPOINT.anonKey}
  data-guide={guide}
  data-source={source}
  data-tags={JSON.stringify(tags)}
>
  <form id={formId} class="grid gap-7" novalidate>
    <div class="grid gap-7 sm:grid-cols-2">
      <div class="field">
        <label for={`${formId}-name`}>First name</label>
        <input id={`${formId}-name`} name="name" type="text" autocomplete="given-name" required maxlength="80" />
      </div>
      <div class="field">
        <label for={`${formId}-email`}>Email</label>
        <input id={`${formId}-email`} name="email" type="email" autocomplete="email" required maxlength="160" />
      </div>
    </div>
    {
      phone && (
        <div class="field">
          <label for={`${formId}-phone`}>Phone (optional)</label>
          <input id={`${formId}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="40" />
        </div>
      )
    }
    {
      role && (
        <div class="field">
          <label for={`${formId}-role`}>{role.label}</label>
          <select id={`${formId}-role`} name="role" required>
            <option value="">Choose one</option>
            {role.options.map((o) => (
              <option value={o}>{o}</option>
            ))}
          </select>
        </div>
      )
    }
    {
      message && (
        <div class="field">
          <label for={`${formId}-message`}>{message.label}</label>
          <textarea
            id={`${formId}-message`}
            name="message"
            maxlength="2000"
            placeholder={message.placeholder}
            required={message.required}
          />
        </div>
      )
    }
    <!-- Honeypot: humans never see or fill this. -->
    <div class="hidden" aria-hidden="true">
      <label>Leave empty <input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="text-[0.78rem] leading-5 text-[var(--cb-ink-3)]">
      {consent} See the{' '}<a class="link-u !text-[var(--cb-ink-2)]" href={getPermalink('/privacy')}>privacy notice</a
      >.
    </p>
    <button type="submit" class="btn-cb btn-cb--block cursor-pointer disabled:cursor-wait disabled:opacity-70">
      <span data-label>{buttonText}</span>
      <span class="btn-cb__icon" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"
          ><path d="M1 6H11M11 6L6.5 1.5M11 6L6.5 10.5" stroke="currentColor" stroke-width="1.5"></path></svg
        >
      </span>
    </button>
    <p class="text-sm text-[var(--cb-alert)]" role="alert" data-error hidden></p>
  </form>
  <div data-success hidden tabindex="-1" class="panel">
    <p class="eyebrow"><span class="idx">✓</span> Received</p>
    <p class="mt-4 text-2xl font-semibold tracking-tight text-[var(--cb-ink)]">{successTitle}</p>
    <p class="mt-3 leading-7">{successBody}</p>
    {
      downloadHref && (
        <a class="btn-cb mt-6" href={downloadHref} download>
          <span>{downloadText}</span>
          <span class="btn-cb__icon" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 1V11M6 11L1.5 6.5M6 11L10.5 6.5" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </span>
        </a>
      )
    }
  </div>
</cb-lead-form>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  class CbLeadForm extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', (e) => this.submit(e, form));
    }

    async submit(e: SubmitEvent, form: HTMLFormElement) {
      e.preventDefault();
      const errorEl = this.querySelector<HTMLElement>('[data-error]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      const label = button.querySelector<HTMLElement>('[data-label]');
      const data = new FormData(form);
      const value = (k: string) => String(data.get(k) || '').trim();
      const name = value('name');
      const email = value('email').toLowerCase();
      const role = value('role');
      const message = value('message');
      const phone = value('phone');

      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      const invalid = (field: string, msg: string) => {
        form.querySelector(`[name="${field}"]`)?.setAttribute('aria-invalid', 'true');
        (form.querySelector(`[name="${field}"]`) as HTMLElement | null)?.focus();
        return this.fail(errorEl, msg);
      };

      if (data.get('company')) return this.done(form);
      if (!name) return invalid('name', 'Please add your first name.');
      if (!EMAIL.test(email)) return invalid('email', 'Please enter a valid email address.');
      if (form.querySelector('[name="role"]') && !role) return invalid('role', 'Please choose one option.');
      const msgEl = form.querySelector<HTMLTextAreaElement>('[name="message"]');
      if (msgEl?.required && !message) return invalid('message', 'Please add a short message.');

      const tags: string[] = JSON.parse(this.dataset.tags || '[]');
      if (role) tags.push(`role:${role}`);

      button.disabled = true;
      const original = label?.textContent;
      if (label) label.textContent = 'Sending…';
      errorEl.hidden = true;
      try {
        const res = await fetch(this.dataset.endpoint!, {
          method: 'POST',
          headers: {
            apikey: this.dataset.key!,
            Authorization: `Bearer ${this.dataset.key}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            name,
            email,
            ...(phone ? { phone } : {}),
            ...(message ? { message } : {}),
            source: `chrisbroomhead-site:${this.dataset.source}`,
            guide: this.dataset.guide,
            tags,
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        this.done(form);
      } catch {
        button.disabled = false;
        if (label && original) label.textContent = original;
        this.fail(errorEl, 'That did not go through. Please try again, or email admin@chrisbroomheadcoaching.com.');
      }
    }

    fail(el: HTMLElement, message: string) {
      el.textContent = message;
      el.hidden = false;
    }

    done(form: HTMLFormElement) {
      form.hidden = true;
      const success = this.querySelector<HTMLElement>('[data-success]')!;
      success.hidden = false;
      success.focus();
    }
  }

  if (!customElements.get('cb-lead-form')) customElements.define('cb-lead-form', CbLeadForm);
</script>
