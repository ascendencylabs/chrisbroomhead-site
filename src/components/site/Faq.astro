---
export interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq border-t border-[var(--cb-line-strong)]">
  {
    items.map((item) => (
      <details>
        <summary>
          {item.q}
          <span class="plus" aria-hidden="true" />
        </summary>
        <div>
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>
