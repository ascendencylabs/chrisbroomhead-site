---
// Client-side lead capture for the insert-only Supabase `leads` endpoint.
// The anon key is insert-only (RLS), so it can never read lead data back.
// The form always lets the visitor through to the download; it reports the
// true save outcome instead of pretending.
import { LEADS_ENDPOINT } from '~/data/site';

interface Props {
  source: string;
  buttonText?: string;
  successMessage?: string;
  downloadHref?: string;
  collectName?: boolean;
}

const {
  source,
  buttonText = 'Send it to me',
  successMessage = 'You are in. Your download is below.',
  downloadHref = '',
  collectName = true,
} = Astro.props;
---

<div
  class="lead-capture max-w-xl mx-auto rounded-lg backdrop-blur border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow p-4 sm:p-6 lg:p-8 w-full"
  data-endpoint={LEADS_ENDPOINT.url}
  data-anon-key={LEADS_ENDPOINT.anonKey}
  data-source={source}
  data-download={downloadHref}
>
  <form class="flex flex-col gap-4">
    {
      collectName && (
        <div>
          <label for={`${source}-name`} class="block text-sm font-medium mb-1">
            Name <span class="text-muted">(optional)</span>
          </label>
          <input
            id={`${source}-name`}
            name="name"
            type="text"
            autocomplete="name"
            class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-page dark:bg-slate-800 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
            placeholder="Your name"
          />
        </div>
      )
    }
    <div>
      <label for={`${source}-email`} class="block text-sm font-medium mb-1">Email</label>
      <input
        id={`${source}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-page dark:bg-slate-800 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        placeholder="you@example.com"
      />
    </div>
    <p class="text-xs text-muted">
      Your email goes to {source === 'community-waitlist' ? 'the community waitlist' : 'the download list'} only. No spam,
      unsubscribe any time.
    </p>
    <button type="submit" class="btn btn-primary w-full" data-submit>{buttonText}</button>
    <p class="status text-sm min-h-5" role="status" aria-live="polite"></p>
  </form>
  <div class="success hidden text-center py-4">
    <p class="text-lg font-semibold">{successMessage}</p>
    {
      downloadHref && (
        <a href={downloadHref} download class="btn btn-primary mt-4 inline-flex items-center gap-2">
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Download the PDF
        </a>
      )
    }
  </div>
</div>

<script>
  document.querySelectorAll('.lead-capture').forEach((root) => {
    const capture = root as HTMLElement;
    const form = capture.querySelector('form');
    const status = capture.querySelector('.status') as HTMLElement | null;
    const success = capture.querySelector('.success');
    const submit = capture.querySelector('[data-submit]') as HTMLButtonElement | null;
    if (!form || !status || !success || !submit) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement | null;
      const nameInput = form.querySelector('input[name="name"]') as HTMLInputElement | null;
      const email = emailInput?.value?.trim();
      if (!email) return;

      submit.disabled = true;
      status.textContent = 'Saving your place…';
      status.className = 'status text-sm min-h-5 text-muted';

      let saved: boolean;
      try {
        const response = await fetch(capture.dataset.endpoint!, {
          method: 'POST',
          headers: {
            apikey: capture.dataset.anonKey!,
            Authorization: `Bearer ${capture.dataset.anonKey}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            email,
            name: nameInput?.value?.trim() || null,
            source: capture.dataset.source,
          }),
        });
        saved = response.ok;
      } catch {
        saved = false;
      }

      form.classList.add('hidden');
      success.classList.remove('hidden');
      if (saved) {
        status.remove();
      } else {
        status.className = 'status text-sm min-h-5 text-muted';
        status.textContent =
          'We could not save your email just now — you can still take the download. Contact admin@chrisbroomheadcoaching.com to be added manually.';
        success.prepend(status);
      }
    });
  });
</script>
